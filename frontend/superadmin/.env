# Set to "true" to force the app onto built-in mock data regardless of
# whether the backend is reachable (useful for offline UI work or preview
# deploys without a backend). Leave "false" now that the real Spring Boot
# backend exists - the app will still fall back to mock data automatically
# if the backend is completely unreachable (see src/lib/mock/withFallback.ts),
# but a real error response from a reachable backend always surfaces.
VITE_USE_MOCK_DATA=false

# Base URL of the Spring Boot backend's API, including the /api prefix.
VITE_API_URL=http://localhost:5000/api
